Element) { if (brightness > 125) { // Fundo claro = texto escuro textElement.style.color = \"#5f585a\"; } else { // Fundo escuro = texto branco textElement.style.color = \"#ffffff\"; } }); } }); }); </script> <footer data-elementor-type=\"footer\" data-elementor-id=\"",
